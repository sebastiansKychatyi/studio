# Скопируйте в .env и заполните. Без этих ключей форма откроет почтовую программу (mailto).

# Telegram: создайте бота у @BotFather → токен; напишите боту, затем
# откройте https://api.telegram.org/bot<TOKEN>/getUpdates и возьмите chat.id
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# Письмо на e-mail: бесплатный ключ на https://web3forms.com (вводите свой e-mail)
NUXT_WEB3FORMS_KEY=
