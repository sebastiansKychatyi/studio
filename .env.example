# Copy to .env. Without these keys the form falls back to mailto.

# Telegram: token from @BotFather; chat.id from https://api.telegram.org/bot<TOKEN>/getUpdates
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=

# E-mail: free access key from https://web3forms.com
NUXT_WEB3FORMS_KEY=

# Team panel backend (FastAPI in backend/)
NUXT_TEAM_API_URL=http://127.0.0.1:8000
