# Copy to backend/.env
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/duo
# Secure cookie needs HTTPS (localhost is fine in Chrome/Firefox)
COOKIE_SECURE=true
SESSION_DAYS=30
# Expense rates: 1 EUR = RATE_UAH hryvnias / RATE_USD dollars (amounts are stored in EUR)
RATE_UAH=51.5
RATE_USD=1.16
# Swagger UI at /api/team/docs
DOCS=true
# Web Push: run `python -m app.cli vapid` and paste the output here (empty = no push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# true = owners may share their calendar in Settings; false = everyone sees only their own
CALENDAR_SHARING=false
# Time zone for scheduled notifications until the panel reports the user's own
DEFAULT_TZ=Europe/Bratislava
# SMTP for monitoring e-mails (empty host = nothing is sent); SMTP_SECURITY: starttls | ssl | none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
# Project monitoring: default recipients (comma separated, overridable in the panel)
MONITORING_ALERT_EMAILS=Kichatyisebastian@gmail.com
# Encrypts environment tokens / webhook secrets in the DB: python -m app.cli fernet (empty = stored as plain text)
MONITORING_SECRET_KEY=
# Seconds between /errors polls (min 30); /status interval is set per environment in the panel
MONITORING_ERRORS_INTERVAL=120
# Usernames allowed to open Monitoring (comma separated; empty = every panel user)
MONITORING_ADMINS=
# Public site address, for "Open" buttons in Telegram messages (https)
SITE_URL=https://studio.k2drive.com
# Telegram bot of the panel (@BotFather → /newbot); empty = no bot. Users connect their chat in Settings → Telegram
TELEGRAM_BOT_TOKEN=
# Assistant: Node runs the quick parser first; what it does not understand goes to the Claude Code CLI
ASSISTANT_NODE=node
ASSISTANT_CLAUDE=claude
# One Claude login per panel user: <folder>/<username> (CLAUDE_CONFIG_DIR=<folder>/<username> claude → /login); empty = parser only
ASSISTANT_CLAUDE_HOME=
ASSISTANT_MODEL=haiku
ASSISTANT_TIMEOUT=120
# Regular chats (Claude with memory): default model (haiku | sonnet | opus; each chat can pick its own) and seconds per answer
ASSISTANT_CHAT_MODEL=sonnet
ASSISTANT_CHAT_TIMEOUT=900
# Code work in regular chats: docker = Claude runs in container claude-<username> (backend/sandbox/setup.sh); empty = no shell, no files
ASSISTANT_SANDBOX=
ASSISTANT_SANDBOX_PREFIX=claude-
# How the container reaches the panel tools; empty = SITE_URL
ASSISTANT_SANDBOX_API=
# The assistant's tools call this API as the user (the uvicorn address on this machine)
INTERNAL_API_URL=http://127.0.0.1:8000
