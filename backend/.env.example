# Copy to backend/.env
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@localhost:5432/duo
# Secure cookie needs HTTPS (localhost is fine in Chrome/Firefox)
COOKIE_SECURE=true
SESSION_DAYS=30
# Expense rates: 1 EUR = RATE_UAH hryvnias / RATE_USD dollars (amounts are stored in EUR)
RATE_UAH=51.5
RATE_USD=1.16
# Swagger UI at /api/team/docs
DOCS=true
